.page-container {
  min-height: 100vh;
  padding: 36rpx 28rpx 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.content-wrap {
  width: 100%;
  max-width: 720rpx;
}

.header {
  text-align: center;
  margin-bottom: 36rpx;
}

.header-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #1c1917;
  letter-spacing: -0.5rpx;
}

.header-subtitle {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #44403c;
}

.card {
  background-color: #ffffff;
  border-radius: 44rpx;
  padding: 44rpx 38rpx;
  box-shadow: 0 16rpx 44rpx rgba(28, 25, 23, 0.07);
  border: 3rpx solid #e7e5e4;
}

/* 门禁卡片 */
.gate-card {
  text-align: center;
}

.gate-icon-box {
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 24rpx;
  border-radius: 36rpx;
  background-color: #ffe4e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.gate-title {
  font-size: 46rpx;
  font-weight: 900;
  color: #1c1917;
}

.gate-desc {
  margin-top: 12rpx;
  font-size: 34rpx;
  color: #57534e;
  line-height: 1.5;
}

.tip-box {
  margin: 32rpx 0;
  background-color: #eff6ff;
  border: 2rpx solid #bfdbfe;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  text-align: left;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e3a8a;
  margin-bottom: 6rpx;
}

.tip-text {
  font-size: 30rpx;
  color: #1e40af;
  line-height: 1.55;
}

.gate-input {
  width: 100%;
  height: 108rpx;
  border-radius: 28rpx;
  border: 3rpx solid #d6d3d1;
  background-color: #fafaf9;
  padding: 0 32rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1917;
  text-align: left;
  margin-bottom: 24rpx;
}

.input-placeholder {
  color: #a8a29e;
  font-weight: 400;
}

.error-inline {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background-color: #fef2f2;
  border: 2rpx solid #fecaca;
  color: #b91c1c;
  font-size: 32rpx;
  font-weight: 700;
}

/* 按钮通用重置 */
button.btn-primary,
button.btn-success,
button.btn-outline {
  width: 100% !important;
  min-height: 124rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
  margin: 0;
}

button.btn-primary {
  background-color: #e11d48;
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(225, 29, 72, 0.26);
}

button.btn-primary:active {
  background-color: #be123c;
  transform: scale(0.99);
}

button.btn-primary[disabled] {
  background-color: #fda4af !important;
  color: #ffffff !important;
  box-shadow: none;
}

button.btn-success {
  background-color: #059669;
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(5, 150, 105, 0.25);
  margin-top: 44rpx;
}

button.btn-success:active {
  background-color: #047857;
}

button.btn-outline {
  background-color: #ffffff;
  color: #44403c;
  border: 3rpx solid #d6d3d1;
  font-size: 38rpx;
  min-height: 112rpx;
}

button.btn-outline:active {
  background-color: #f5f5f4;
}

.mb-gap {
  margin-bottom: 24rpx !important;
}

/* 表单两步区 */
.step-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.step-badge {
  background-color: #ffe4e6;
  color: #be123c;
  font-size: 30rpx;
  font-weight: 900;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
}

.step-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #1c1917;
}

.input-wrapper {
  position: relative;
  width: 100%;
}

.dance-input {
  width: 100%;
  height: 118rpx;
  border-radius: 28rpx;
  border: 4rpx solid #d6d3d1;
  background-color: #fafaf9;
  padding: 0 88rpx 0 32rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #1c1917;
}

.dance-input-error {
  border-color: #dc2626;
  background-color: #fef2f2;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #e7e5e4;
  color: #57534e;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.name-error-box {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background-color: #fef2f2;
  border: 3rpx solid #fca5a5;
  color: #b91c1c;
  font-size: 34rpx;
  font-weight: 800;
}

.preview-pill {
  margin-top: 18rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background-color: #ecfdf5;
  border: 2rpx solid #a7f3d0;
  color: #065f46;
  font-size: 32rpx;
  word-break: break-all;
}

.preview-bold {
  font-weight: 800;
}

.suffix-section {
  margin-top: 28rpx;
}

.suffix-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #57534e;
  margin-bottom: 18rpx;
}

.suffix-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.suffix-chip {
  min-height: 92rpx;
  border-radius: 24rpx;
  border: 3rpx solid #d6d3d1;
  background-color: #fafaf9;
  color: #292524;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.suffix-chip:active {
  background-color: #ffe4e6;
  border-color: #fb7185;
  color: #be123c;
}

.divider {
  height: 2rpx;
  background-color: #e7e5e4;
  margin: 40rpx 0;
}

.btn-upload {
  min-height: 132rpx !important;
  font-size: 44rpx !important;
}

.btn-icon {
  margin-right: 14rpx;
}

.upload-hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: 32rpx;
  color: #57534e;
  font-weight: 500;
}

/* 进度卡片 */
.progress-card {
  text-align: center;
}

.uploading-label {
  font-size: 38rpx;
  font-weight: 800;
  color: #292524;
  word-break: break-all;
}

.percent-number {
  margin: 24rpx 0;
  font-size: 116rpx;
  font-weight: 900;
  color: #e11d48;
  line-height: 1;
}

.progress-track {
  width: 100%;
  height: 44rpx;
  background-color: #e7e5e4;
  border-radius: 22rpx;
  overflow: hidden;
  padding: 4rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #f43f5e, #e11d48);
  transition: width 0.25s ease-out;
}

.progress-meta {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #57534e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.part-badge {
  background-color: #f5f5f4;
  border: 2rpx solid #e7e5e4;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.keep-open-notice {
  margin: 32rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #fffbeb;
  border: 2rpx solid #fde68a;
  color: #92400e;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.5;
}

/* 成功与失败状态卡片 */
.success-card {
  text-align: center;
  border-color: #6ee7b7;
}

.error-card {
  text-align: center;
  border-color: #fecaca;
}

.status-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 84rpx;
}

.success-circle {
  background-color: #d1fae5;
}

.error-circle {
  background-color: #fee2e2;
}

.success-title {
  font-size: 46rpx;
  font-weight: 900;
  color: #1c1917;
  line-height: 1.4;
  word-break: break-all;
}

.saved-file-pill {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 24rpx;
  border-radius: 18rpx;
  background-color: #ecfdf5;
  color: #065f46;
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.status-desc {
  margin-top: 24rpx;
  font-size: 36rpx;
  color: #44403c;
  line-height: 1.55;
}

.error-title {
  font-size: 46rpx;
  font-weight: 900;
  color: #1c1917;
}

.error-detail {
  margin: 22rpx 0 38rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #b91c1c;
  line-height: 1.5;
  word-break: break-all;
}

/* 底部工具栏 */
.footer-bar {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

button.footer-link-btn,
.footer-link-btn {
  width: auto !important;
  background: transparent;
  padding: 12rpx 16rpx;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #78716c;
  line-height: 1.4;
}

.footer-dot {
  color: #d6d3d1;
  font-size: 32rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-box {
  width: 100%;
  max-width: 640rpx;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
}

.modal-icon {
  font-size: 80rpx;
  margin-bottom: 18rpx;
}

.modal-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #1c1917;
  margin-bottom: 18rpx;
}

.modal-msg {
  font-size: 36rpx;
  color: #44403c;
  line-height: 1.6;
  margin-bottom: 38rpx;
}

.privacy-link {
  color: #e11d48;
  font-weight: 800;
  text-decoration: underline;
}

/* 未填名称抖动动画 */
@keyframes shakeHorizontal {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-12rpx); }
  80% { transform: translateX(12rpx); }
}

.animate-shake {
  animation: shakeHorizontal 0.42s ease-in-out;
}
